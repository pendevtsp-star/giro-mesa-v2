# syntax=docker/dockerfile:1
FROM node:24.18.0-bookworm-slim AS builder

ENV COREPACK_HOME=/usr/local/share/corepack
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

ARG VITE_API_URL
ARG VITE_SITE_URL
ARG VITE_DEMO_MODE=false
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_DEMO_MODE=$VITE_DEMO_MODE
RUN pnpm turbo run build --filter="@giromesa/ops"

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/vps/ops-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/ops/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
