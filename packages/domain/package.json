{
  "name": "@giromesa/domain",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./establishment-hours": {
      "types": "./dist/establishment-hours.d.ts",
      "default": "./dist/establishment-hours.js"
    },
    "./floor-geometry": {
      "types": "./dist/floor-geometry.d.ts",
      "default": "./dist/floor-geometry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/domain.test.js dist/doseclub.test.js dist/floor-geometry.test.js dist/permissions.test.js dist/secret-envelope.test.js dist/whatsapp.test.js"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@biomejs/biome": "2.5.2",
    "typescript": "5.9.3"
  }
}
