{
  "name": "@giromesa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir .turbo/test-dist && node --test --test-concurrency=1 .turbo/test-dist/**/*.test.js",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "pnpm build && node dist/seed.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@biomejs/biome": "2.5.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
