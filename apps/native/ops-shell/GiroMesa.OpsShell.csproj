<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GiroMesaAndroidTarget)' == 'true'">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GiroMesaMobileTargets)' == 'true'">net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>GiroMesa.OpsShell</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>GiroMesa Operação</ApplicationTitle>
    <ApplicationId>br.com.giromesa.operacao</ApplicationId>
    <ApplicationDisplayVersion>0.2.6</ApplicationDisplayVersion>
    <ApplicationVersion>4</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SmartPosProvider Condition="'$(SmartPosProvider)' == ''">disabled</SmartPosProvider>
    <SmartPosEnvironment Condition="'$(SmartPosEnvironment)' == ''">disabled</SmartPosEnvironment>
    <SmartPosPackage Condition="'$(SmartPosPackage)' == ''"></SmartPosPackage>
    <SmartPosAllowedPackages Condition="'$(SmartPosAllowedPackages)' == ''"></SmartPosAllowedPackages>
    <SmartPosAllowedSchemes Condition="'$(SmartPosAllowedSchemes)' == ''"></SmartPosAllowedSchemes>
    <SmartPosMethods Condition="'$(SmartPosMethods)' == ''"></SmartPosMethods>
    <SmartPosStartUriTemplate Condition="'$(SmartPosStartUriTemplate)' == ''"></SmartPosStartUriTemplate>
    <SmartPosRecoverUriTemplate Condition="'$(SmartPosRecoverUriTemplate)' == ''"></SmartPosRecoverUriTemplate>
    <SmartPosCancelUriTemplate Condition="'$(SmartPosCancelUriTemplate)' == ''"></SmartPosCancelUriTemplate>
    <SmartPosTimeoutSeconds Condition="'$(SmartPosTimeoutSeconds)' == ''">180</SmartPosTimeoutSeconds>
    <SmartPosApiBaseUrl Condition="'$(SmartPosApiBaseUrl)' == ''">https://api.giromesa.com.br</SmartPosApiBaseUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GiroMesa.SmartPos.Provider" Value="$(SmartPosProvider)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.Environment" Value="$(SmartPosEnvironment)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.Package" Value="$(SmartPosPackage)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.AllowedPackages" Value="$(SmartPosAllowedPackages)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.AllowedSchemes" Value="$(SmartPosAllowedSchemes)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.Methods" Value="$(SmartPosMethods)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.StartUriTemplate" Value="$(SmartPosStartUriTemplate)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.RecoverUriTemplate" Value="$(SmartPosRecoverUriTemplate)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.CancelUriTemplate" Value="$(SmartPosCancelUriTemplate)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.TimeoutSeconds" Value="$(SmartPosTimeoutSeconds)" />
    <AssemblyMetadata Include="GiroMesa.SmartPos.ApiBaseUrl" Value="$(SmartPosApiBaseUrl)" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="checks\**\*.cs" />
    <None Remove="checks\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>
</Project>
